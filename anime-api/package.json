{
  "name": "anime-api",
  "version": "1.0.0",
  "private": true,
  "description": "Dockerized Node.js API with PostgreSQL for anime CRUD",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/src/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "create:key": "tsx scripts/createApiKey.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
